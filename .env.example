# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_PASSWORD: Explicit custom password to login to the administrator mode.
# If configured, you can type this custom password (instead of your raw GEMINI_API_KEY) in the browser UI to unlock AI creation features.
# Highly recommended for security and convenience across devices like mobile.
ADMIN_PASSWORD=Topepe953

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: GitHub Personal Access Token (PAT) used to fetch/save recipes.
# Use your personal access token. Never commit your real token to git.
GITHUB_TOKEN=

# GITHUB_USERNAME: Your GitHub username (owner of the repository).
GITHUB_USERNAME=

# GITHUB_REPO: Repository name where recipes are stored (e.g., ai-kucharka).
GITHUB_REPO=

# GITHUB_BRANCH: Git branch name (default is main).
GITHUB_BRANCH=
